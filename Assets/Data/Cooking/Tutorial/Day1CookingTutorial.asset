  steps:
  - stepId: banh_mi_bread
    instructionText: "\u0110\u01A1n t\u1EA1i b\xE0n \u0111\u1EA7u ti\xEAn: B\xE1nh
      M\xEC Th\u1ECBt N\u01B0\u1EDBng! Ch\u1EA1m V\u1ECF b\xE1nh m\xEC \u0111\u1EC3
      n\u01B0\u1EDBng gi\xF2n trong L\xF2 \xE9p."
    targetAnchorIds:
    - tray.bread
    blockOutsideInputs: 1
    showSpotlight: 1
    showHandPointer: 1
    tooltipPlacement: 0
    spawnOrderBeforeStep: 1
    orderToSpawn: {fileID: 11400000, guid: 88e011c823cb2114a8b37091ef4644b1, type: 2}
    orderIsShip: 0
    orderPreferredLane: 0
    completionRule: 0
    targetBoardIndex: 0
    ingredientGoals:
    - ingredientId: bread
      requiredAmount: 1
  - stepId: banh_mi_pork
    instructionText: "M\xF3n n\xE0y c\u1EA7n 3 ph\u1EA7n Th\u1ECBt heo n\u01B0\u1EDBng.
      Ch\u1EA1m Th\u1ECBt heo 3 l\u1EA7n \u0111\u1EC3 l\u1EA5p \u0111\u1EA7y 3 \xF4
      tr\xEAn V\u1EC9 n\u01B0\u1EDBng!"
