    - tray.pork
    blockOutsideInputs: 1
    showSpotlight: 1
    showHandPointer: 1
    tooltipPlacement: 0
    spawnOrderBeforeStep: 0
    orderToSpawn: {fileID: 0}
    orderIsShip: 0
    orderPreferredLane: -1
    completionRule: 0
    targetBoardIndex: 0
