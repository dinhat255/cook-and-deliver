  id: tteokbokki_cay
  recipeName: Tteokbokki Cay
  region: "H\xE0n Qu\u1ED1c"
  basePrice: 100
  dishDescription: "B\xE1nh g\u1EA1o d\u1EBBo m\u1EC1m x\xE0o c\xF9ng s\u1ED1t \u1EDBt
    cay n\u1ED3ng ki\u1EC3u H\xE0n Qu\u1ED1c, k\u1EBFt h\u1EE3p kim chi c\u1EA3i
    th\u1EA3o chua d\u1ECBu v\xE0 h\xE0nh l\xE1 t\u01B0\u01A1i."
  culturalStory: "Phi\xEAn b\u1EA3n Tteokbokki s\u1ED1t \u1EDBt \u0111\u1ECF ra \u0111\u1EDDi
    t\u1EA1i Seoul v\xE0o th\u1EADp ni\xEAn 1950, nhanh ch\xF3ng ph\u1ED5 bi\u1EBFn
    kh\u1EAFp c\xE1c khu ph\u1ED1 \u1EA9m th\u1EF1c \u0111\u01B0\u1EDDng ph\u1ED1
    H\xE0n Qu\u1ED1c nh\u1EDD v\u1ECB cay n\xF3ng d\u1EC5 \u0103n."
  flavorProfile: "Cay ng\u1ECDt \u0111\u1EADm \u0111\xE0, b\xE1nh g\u1EA1o d\u1EBBo
    dai, kim chi chua gi\xF2n c\xE2n b\u1EB1ng v\u1ECB gi\xE1c"
  chefTip: "X\xE0o \u0111\u1EC1u 3 ph\u1EA7n b\xE1nh g\u1EA1o tr\xEAn ch\u1EA3o s\u1ED1t,
    r\u1ED3i th\xEAm s\u1ED1t cay, kim chi v\xE0 h\xE0nh l\xE1 \u0111\u1EC3 ho\xE0n
    thi\u1EC7n m\xF3n."
