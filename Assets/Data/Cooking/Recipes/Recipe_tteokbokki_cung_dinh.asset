  m_Name: Recipe_tteokbokki_cung_dinh
  m_EditorClassIdentifier: Assembly-CSharp::CookAndDeliver.Cooking.Data.RecipeSO
  id: tteokbokki_cung_dinh
  recipeName: "Tteokbokki Cung \u0110\xECnh"
  region: "H\xE0n Qu\u1ED1c"
  basePrice: 135
  dishDescription: "B\xE1nh g\u1EA1o d\u1EBBo m\u1EC1m k\u1EBFt h\u1EE3p th\u1ECBt
    b\xF2 n\u01B0\u1EDBng, n\u01B0\u1EDBc t\u01B0\u01A1ng \u0111\u1EADm v\u1ECB v\xE0
    h\xE0nh l\xE1 thanh nh\u1EB9, kh\xF4ng cay theo phong c\xE1ch cung \u0111\xECnh."
  culturalStory: "Gungjung Tteokbokki l\xE0 m\xF3n \u0103n truy\u1EC1n th\u1ED1ng
    c\xF3 t\u1EEB th\u1EDDi tri\u1EC1u \u0111\u1EA1i Joseon \u1EDF H\xE0n Qu\u1ED1c.
    Kh\xE1c v\u1EDBi phi\xEAn b\u1EA3n s\u1ED1t \u1EDBt \u0111\u1ECF \u0111\u01B0\u1EDDng
    ph\u1ED1 sau n\xE0y, m\xF3n \u0103n cung \u0111\xECnh ch\xFA tr\u1ECDng v\u1ECB
    m\u1EB7n ng\u1ECDt thanh tao t\u1EEB n\u01B0\u1EDBc t\u01B0\u01A1ng v\xE0 th\u1ECBt
    b\xF2."
  flavorProfile: "M\u1EB7n ng\u1ECDt thanh tao t\u1EEB n\u01B0\u1EDBc t\u01B0\u01A1ng,
    b\xE1nh g\u1EA1o d\u1EBBo m\u1EC1m, th\u1ECBt b\xF2 \u0111\u1EADm \u0111\xE0
    v\xE0 h\xE0nh l\xE1 th\u01A1m nh\u1EB9"
  chefTip: "X\xE0o 3 ph\u1EA7n b\xE1nh g\u1EA1o tr\xEAn ch\u1EA3o, n\u01B0\u1EDBng
    2 ph\u1EA7n th\u1ECBt b\xF2 tr\xEAn v\u1EC9 r\u1ED3i r\u01B0\u1EDBi n\u01B0\u1EDBc
    t\u01B0\u01A1ng v\xE0 h\xE0nh l\xE1 tr\u1EF1c ti\u1EBFp l\xEAn th\u1EDBt."
  isUnlockedByDefault: 0
