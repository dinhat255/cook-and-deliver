  m_Name: Recipe_tteokbokki_cung_dinh
  m_EditorClassIdentifier: Assembly-CSharp::CookAndDeliver.Cooking.Data.RecipeSO
  id: tteokbokki_cung_dinh
  recipeName: "Tteokbokki Cung \u0110\xECnh"
  region: "H\xE0n Qu\u1ED1c"
  basePrice: 135
  dishDescription: "B\xE1nh g\u1EA1o d\u1EBBo th\u01A1m x\xE0o c\xF9ng th\u1ECBt b\xF2 n\u01B0\u1EDBng v\xE0 x\u1ED1t t\u01B0\u01A1ng \u0111\u1EADu thanh ng\u1ECDt, kh\xF4ng cay theo phong c\xE1ch ho\xE0ng gia."
  culturalStory: "Gungjung Tteokbokki l\xE0 m\xF3n \u0103n cao qu\xF3i t\u1EEB th\u1EDDi tri\u1EC1u \u0111\u1EA1i Joseon, t\u1EEBng \u0111\u01B0\u1EE3c d\xE2ng l\xEAn c\xE1c b\u1EADc vua ch\xFAa. Kh\xE1c v\u1EDBi phi\xEAn b\u1EA3n \u0111\u01B0\u1EDDng ph\u1ED1 ng\xE0y nay, m\xF3n \u0103n n\xE0y ch\xFA tr\u1ECDng v\u1ECB thanh tao, k\u1EBFt h\u1EE3p gi\u1EEFa b\xE1nh g\u1EA1o v\xE0 th\u1ECBt b\xF2 x\u1ED1t t\u01B0\u01A1ng."
  flavorProfile: "Ng\u1ECDt thanh t\u1EF1 nhi\xEAn, b\xE1nh g\u1EA1o d\u1EBBo b\xF9i, th\u1ECBt b\xF2 \u0111\u1EADm \u0111\xE0 x\u1ED1t t\u01B0\u01A1ng \u0111\u1EADu"
  chefTip: "\u0110\u1EA3o th\u1ECBt b\xF2 v\xE0 b\xE1nh g\u1EA1o tr\xEAn ch\u1EA3o \u1EDF l\u1EEDa l\u1EDBn \u0111\u1EC3 x\u1ED1t t\u01B0\u01A1ng \xE1o \u0111\u1EC1u m\xE0u n\xE2u \xF3ng \u1EA3"
  isUnlockedByDefault: 0
  unlockCostCoins: 200
