  m_EditorClassIdentifier: Assembly-CSharp::CookAndDeliver.Cooking.Data.RecipeSO
  id: banh_mi_thit_nuong
  recipeName: "B\xE1nh M\xEC Th\u1ECBt N\u01B0\u1EDBng"
  region: "Vi\u1EC7t Nam"
  basePrice: 110
  dishDescription: "\u1ED4 b\xE1nh m\xEC v\u1ECF gi\xF2n k\u1EB9p th\u1ECBt heo n\u01B0\u1EDBng
    s\u1EA3 th\u01A1m l\u1EEBng, \u0103n k\xE8m d\u01B0a leo ng\xF2 r\xED m\xE1t
    gi\xF2n v\xE0 s\u1ED1t cay \u0111\u1EADm v\u1ECB."
  culturalStory: "Kh\u1EDFi ngu\u1ED3n t\u1EEB b\xE1nh m\xEC baguette Ph\xE1p, ng\u01B0\u1EDDi
    Vi\u1EC7t bi\u1EBFn t\u1EA5u th\xE0nh b\xE1nh m\xEC v\u1ECF gi\xF2n ru\u1ED9t
    x\u1ED1p k\u1EB9p th\u1ECBt n\u01B0\u1EDBng, \u0111\u1ED3 chua v\xE0 rau m\xF9i,
    tr\u1EDF th\xE0nh m\xF3n \u0103n \u0111\u01B0\u1EDDng ph\u1ED1 quen thu\u1ED9c
    kh\u1EAFp c\u1EA3 n\u01B0\u1EDBc."
  flavorProfile: "V\u1ECF b\xE1nh gi\xF2n r\u1EE5m, th\u1ECBt heo n\u01B0\u1EDBng
    s\u1EA3 \u0111\u1EADm \u0111\xE0, d\u01B0a ng\xF2 thanh m\xE1t v\xE0 s\u1ED1t
    cay k\xEDch th\xEDch v\u1ECB gi\xE1c"
  chefTip: "\xC9p n\xF3ng v\u1ECF b\xE1nh m\xEC trong l\xF2 v\xE0 n\u01B0\u1EDBng
    \u0111\u1EE7 3 ph\u1EA7n th\u1ECBt heo tr\xEAn v\u1EC9, sau \u0111\xF3 th\xEAm
    d\u01B0a ng\xF2 v\xE0 s\u1ED1t cay l\xEAn th\u1EDBt."
