  id: banh_mi_thit_nuong
  recipeName: "B\xE1nh M\xEC Th\u1ECBt N\u01B0\u1EDBng"
  region: "Vi\u1EC7t Nam"
  basePrice: 110
  dishDescription: "V\u1ECF b\xE1nh m\xEC gi\xF2n tan k\u1EB9p th\u1ECBt heo n\u01B0\u1EDBng s\u1EA3 th\u01A1m l\u1EEBng tr\xEAn than hoa, k\u1EBFt h\u1EE3p rau th\u01A1m thanh m\xE1t v\xE0 \u1EDBt t\u01B0\u01A1i cay n\u1ED3ng."
  culturalStory: "Kh\u1EDFi ngu\u1ED3n t\u1EEB baguette Ph\xE1p, ng\u01B0\u1EDDi Vi\u1EC7t \u0111\xE3 s\xE1ng t\u1EA1o n\xEAn chi\u1EBFc b\xE1nh m\xEC v\u1ECF gi\xF2n ru\u1ED9t x\u1ED1p k\u1EB9p th\u1ECBt n\u01B0\u1EDBng \u0111\u1EB7c s\u1EAFc, tr\u1EDF th\xE0nh bi\u1EC3u t\u01B0\u1EE3ng \u1EA9m th\u1EF1c \u0111\u01B0\u1EDDng ph\u1ED1 h\xE0ng \u0111\u1EA7u th\u1EBF gi\u1EDBi."
  flavorProfile: "V\u1ECF gi\xF2n r\u1EE5m, th\u1ECBt n\u01B0\u1EDBng \u0111\u1EADm v\u1ECB ng\u1ECDt t\u1EF1 nhi\xEAn, cay n\u1ED3ng t\u1EEB \u1EDBt \u0111\u1ECF"
  chefTip: "\xC9p n\xF3ng v\u1ECF b\xE1nh m\xEC trong l\xF2 tr\u01B0\u1EDBc khi k\u1EB9p th\u1ECBt \u0111\u1EC3 b\xE1nh gi\u1EEF \u0111\u1ED9 gi\xF2n tan l\xE2u nh\u1EA5t"
