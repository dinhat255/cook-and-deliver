  id: banh_mi_thap_cam_giao_hoa
  recipeName: "B\xE1nh M\xEC Th\u1EADp C\u1EA9m Giao H\xF2a"
  region: Fusion
  basePrice: 160
  dishDescription: "Tuy\u1EC7t ph\u1EA9m \u0111\u1EB7c bi\u1EC7t c\u1EE7a qu\xE1n: K\u1EB9p c\u1EA3 th\u1ECBt b\xF2 n\u01B0\u1EDBng Bulgogi, th\u1ECBt heo n\u01B0\u1EDBng s\u1EA3, kim chi cay gi\xF2n v\xE0 rau th\u01A1m Vi\u1EC7t Nam."
  culturalStory: "Bi\u1EC3u t\u01B0\u1EE3ng cao nh\u1EA5t c\u1EE7a B\u1EBFp Giao H\xF2a, n\u01A1i hai n\u1EC1n v\u0103n h\xF3a \u1EA9m th\u1EF1c n\u1ED3ng h\u1EADu b\u1EADc nh\u1EA5t ch\xE2u \xC1 h\xF2a quy\u1EC7n ho\xE0n h\u1EA3o trong m\u1ED9t \u1ED5 b\xE1nh m\xEC gi\xF2n tan."
  flavorProfile: "T\u1EA7ng h\u01B0\u01A1ng phong ph\xFA: V\u1ECF gi\xF2n, th\u1ECBt \u0111\u1EADm \u0111\xE0, kim chi chua thanh c\xE2n b\u1EB1ng v\u1ECB cay \u1EDBt"
  chefTip: "C\u1EA7n n\u01B0\u1EDBng ch\xEDn c\u1EA3 hai lo\u1EA1i th\u1ECBt tr\u01B0\u1EDBc khi l\u1EAFp r\xE1p \u0111\u1EC3 b\xE1nh kh\xF4ng b\u1ECB ngu\u1ED9i"
