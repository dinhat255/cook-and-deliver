  recipeName: "B\xE1nh M\xEC Th\u1EADp C\u1EA9m"
  region: "Vi\u1EC7t Nam"
  basePrice: 160
  dishDescription: "\u1ED4 b\xE1nh m\xEC th\u1EADp c\u1EA9m \u0111\u1EA7y \u0111\u1EB7n
    k\u1EB9p hai lo\u1EA1i th\u1ECBt heo n\u01B0\u1EDBng v\xE0 th\u1ECBt b\xF2 n\u01B0\u1EDBng,
    \u0103n k\xE8m d\u01B0a leo ng\xF2 r\xED thanh m\xE1t."
  culturalStory: "B\xE1nh m\xEC th\u1EADp c\u1EA9m l\xE0 bi\u1EBFn t\u1EA5u quen
    thu\u1ED9c t\u1EA1i c\xE1c ti\u1EC7m b\xE1nh m\xEC Vi\u1EC7t Nam, k\u1EBFt h\u1EE3p
    nhi\u1EC1u lo\u1EA1i nh\xE2n th\u1ECBt c\xF9ng rau d\u01B0a gi\xF2n m\xE1t trong
    m\u1ED9t \u1ED5 b\xE1nh gi\xF2n r\u1EE5m cho b\u1EEFa \u0103n no \u0111\u1EE7."
  flavorProfile: "V\u1ECF b\xE1nh m\xEC gi\xF2n tan, nh\xE2n th\u1ECBt heo v\xE0
    th\u1ECBt b\xF2 \u0111\u1EADm \u0111\xE0 quy\u1EC7n c\xF9ng d\u01B0a ng\xF2 t\u01B0\u01A1i
    m\xE1t"
  chefTip: "N\u01B0\u1EDBng n\xF3ng v\u1ECF b\xE1nh trong l\xF2 \xE9p c\xF9ng 2 ph\u1EA7n
    th\u1ECBt heo v\xE0 1 ph\u1EA7n th\u1ECBt b\xF2 tr\xEAn v\u1EC9, r\u1ED3i th\xEAm
    d\u01B0a ng\xF2 \u0111\u1EC3 gi\u1EEF \u0111\u1ED9 gi\xF2n t\u01B0\u01A1i."
