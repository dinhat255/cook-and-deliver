  id: mi_xao_kimchi_thit_heo
  recipeName: "M\xEC X\xE0o Kim Chi Th\u1ECBt Heo"
  region: "H\xE0n Qu\u1ED1c"
  basePrice: 125
  dishDescription: "\u0110\u0129a m\xEC x\xE0o s\u0103n s\u1EE3i v\xE0ng \u01B0\u01A1m
    k\u1EBFt h\u1EE3p th\u1ECBt heo n\u01B0\u1EDBng th\u01A1m b\xE9o, kim chi c\u1EA3i
    th\u1EA3o chua cay v\xE0 h\xE0nh l\xE1 r\u1EAFc m\u1EB7t."
  culturalStory: "Kimchi Bokkeum-myeon l\xE0 m\xF3n m\xEC x\xE0o ph\u1ED5 bi\u1EBFn
    trong b\u1EEFa \u0103n gia \u0111\xECnh v\xE0 qu\xE1n \u0103n b\xECnh d\xE2n
    t\u1EA1i H\xE0n Qu\u1ED1c, t\u1EADn d\u1EE5ng v\u1ECB chua cay c\u1EE7a kim chi
    x\xE0o s\u0103n c\xF9ng s\u1EE3i m\xEC v\xE0 th\u1ECBt heo."
  flavorProfile: "S\u1EE3i m\xEC x\xE0o dai th\u01A1m, th\u1ECBt heo n\u01B0\u1EDBng
    b\xE9o ng\u1EADy h\xF2a quy\u1EC7n kim chi chua cay v\xE0 h\xE0nh l\xE1 d\u1EADy
    m\xF9i"
  chefTip: "X\xE0o ch\xEDn s\u1EE3i m\xEC tr\xEAn ch\u1EA3o v\xE0 n\u01B0\u1EDBng
    2 ph\u1EA7n th\u1ECBt heo tr\xEAn v\u1EC9, sau \u0111\xF3 x\u1EBFp c\xF9ng kim
    chi v\xE0 h\xE0nh l\xE1 l\xEAn \u0111\u0129a."
